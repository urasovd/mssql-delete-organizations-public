#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Подготовка копии информационной базы после выделения организаций.
//
// Два раздела:
//  - файлы на томах: загрузка присоединенных файлов в информационную базу без
//    удаления файлов с тома (тома копии обычно указывают на боевое хранилище);
//  - проводки удаляемых документов: перенос движений документов, виды которых
//    исчезнут при переходе на типовую конфигурацию, в документы "Операция (бух)".
//
// Методы принимают и возвращают структуры из примитивных значений, поэтому их можно
// вызывать и из формы, и из скриптов (через MCP_Toolkit или COM).

#Область ПрограммныйИнтерфейс

#Область ФайлыНаТомах

// Параметры методов ПроверитьФайлыНаТомах и ЗагрузитьФайлыВБазу.
//
// Возвращаемое значение:
//  Структура:
//   * ПодменаПутей - Массив из Строка - строки "откуда => куда": начало пути тома заменяется
//                    при чтении файла (например, когда сервер 1С читает копию файлов из
//                    локального каталога вместо сетевого тома).
//   * Порция - Число - сколько файлов обработать за вызов.
//   * ПорцияМБ - Число - сколько мегабайт загрузить за вызов (загрузка останавливается после
//                файла, на котором порция превышена).
//   * Позиция - Число - сколько файлов пропустить с начала списка (значение из прошлого вызова).
//   * СверятьРазмер - Булево - считать ошибкой расхождение размера файла и реквизита "Размер".
//
Функция ПараметрыФайлов() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ПодменаПутей", Новый Массив);
	Параметры.Вставить("Порция", 200);
	Параметры.Вставить("ПорцияМБ", 200);
	Параметры.Вставить("Позиция", 0);
	Параметры.Вставить("СверятьРазмер", Истина);
	Возврат Параметры;

КонецФункции

// Сводка файлов, которые хранятся в томах.
//
// Возвращаемое значение:
//  Структура:
//   * Файлов - Число
//   * Размер - Число - байт
//   * Справочники - Массив из Структура: Справочник, Файлов, Размер
//   * Тома - Массив из Структура: Том, Путь, Файлов, Размер
//   * СпособХранения - Строка - "ВИнформационнойБазе", "ВТомахНаДиске" или "ВИнформационнойБазеИТомахНаДиске"
//
Функция СводкаФайловНаТомах() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура("Файлов, Размер, Справочники, Тома, СпособХранения", 0, 0,
		Новый Массив, Новый Массив, СпособХраненияФайлов());

	ПоТомам = Новый Соответствие;
	Для Каждого ИмяСправочника Из СправочникиФайлов() Цикл
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Том КАК Том,
		|	КОЛИЧЕСТВО(*) КАК Файлов,
		|	ЕСТЬNULL(СУММА(Т.Размер), 0) КАК Размер
		|ИЗ
		|	" + ИмяСправочника + " КАК Т
		|ГДЕ
		|	Т.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВТомахНаДиске)
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.Том");
		Выборка = Запрос.Выполнить().Выбрать();
		ФайловСправочника = 0;
		РазмерСправочника = 0;
		Пока Выборка.Следующий() Цикл
			ФайловСправочника = ФайловСправочника + Выборка.Файлов;
			РазмерСправочника = РазмерСправочника + Выборка.Размер;
			Итог = ПоТомам.Получить(Выборка.Том);
			Если Итог = Неопределено Тогда
				Итог = Новый Структура("Файлов, Размер", 0, 0);
				ПоТомам.Вставить(Выборка.Том, Итог);
			КонецЕсли;
			Итог.Файлов = Итог.Файлов + Выборка.Файлов;
			Итог.Размер = Итог.Размер + Выборка.Размер;
		КонецЦикла;
		Если ФайловСправочника > 0 Тогда
			Результат.Справочники.Добавить(Новый Структура("Справочник, Файлов, Размер",
				ИмяСправочника, ФайловСправочника, РазмерСправочника));
			Результат.Файлов = Результат.Файлов + ФайловСправочника;
			Результат.Размер = Результат.Размер + РазмерСправочника;
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючИЗначение Из ПоТомам Цикл
		Результат.Тома.Добавить(Новый Структура("Том, Путь, Файлов, Размер",
			Строка(КлючИЗначение.Ключ), ПутьТома(КлючИЗначение.Ключ),
			КлючИЗначение.Значение.Файлов, КлючИЗначение.Значение.Размер));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Видит ли сервер 1С каталоги томов. Сервер читает файлы под своей учетной записью
// (обычно локальной), у которой может не быть доступа к сетевому хранилищу.
//
// Параметры:
//  ПодменаПутей - Массив из Строка - см. ПараметрыФайлов
//
// Возвращаемое значение:
//  Структура:
//   * КаталогВременныхФайлов - Строка - по нему видно, под какой учетной записью работает сервер
//   * Тома - Массив из Структура: Том, Путь, Доступен
//
Функция ДоступСервераКТомам(ПодменаПутей = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Подмена = РазобратьПодменуПутей(?(ПодменаПутей = Неопределено, Новый Массив, ПодменаПутей));
	Результат = Новый Структура("КаталогВременныхФайлов, Тома", КаталогВременныхФайлов(), Новый Массив);
	Для Каждого ОписаниеТома Из СводкаФайловНаТомах().Тома Цикл
		Путь = ПрименитьПодмену(ОписаниеТома.Путь, Подмена);
		Каталог = Новый Файл(Путь);
		Результат.Тома.Добавить(Новый Структура("Том, Путь, Доступен", ОписаниеТома.Том, Путь,
			Каталог.Существует() И Каталог.ЭтоКаталог()));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сохраняет учетные данные Windows (cmdkey) для учетной записи, под которой работает сервер 1С:
// команду запускает серверный процесс 1С. Пароль учетной записи сервера не нужен.
// Пароль не записывается ни в базу, ни в журнал регистрации.
//
// Параметры:
//  Сервер - Строка - имя сервера хранилища, например "fileserver".
//  Пользователь - Строка - например "DOMAIN\fileshare".
//  Пароль - Строка
//
// Возвращаемое значение:
//  Число - код возврата cmdkey
//
Функция СохранитьУчетныеДанныеСервера(Сервер, Пользователь, Пароль) Экспорт

	Если Не ЭтоWindows() Тогда
		ВызватьИсключение "Сохранение учетных данных поддерживается только для сервера 1С на Windows.";
	КонецЕсли;
	Если СтрНайти(Пароль, """") > 0 Или СтрНайти(Пароль, " ") > 0 Тогда
		ВызватьИсключение "Пароль с кавычками или пробелами не поддерживается: cmdkey получает его в командной строке.";
	КонецЕсли;

	КодВозврата = 0;
	ЗапуститьПриложение(СтрШаблон("cmdkey /add:%1 /user:%2 /pass:%3", Сервер, Пользователь, Пароль), , Истина, КодВозврата);
	ЗаписатьВЖурнал(СтрШаблон("Сохранены учетные данные сервера 1С для %1 (%2), код возврата %3.",
		Сервер, Пользователь, КодВозврата));
	Возврат КодВозврата;

КонецФункции

// Проверяет, что файлы из томов читаются: файл есть и его размер совпадает с реквизитом.
// Ничего не меняет. Вызывается порциями, пока Завершено = Ложь.
//
// Параметры:
//  Параметры - см. ПараметрыФайлов
//
// Возвращаемое значение:
//  см. НовыйРезультатПорции
//
Функция ПроверитьФайлыНаТомах(Параметры) Экспорт

	Возврат ОбработатьПорциюФайлов(Параметры, Ложь);

КонецФункции

// Загружает файлы из томов в информационную базу. Файл на томе не удаляется.
// Вызывается порциями, пока Завершено = Ложь; после сбоя вызов можно повторить
// с той же позицией: загруженные файлы из списка уходят.
//
// Параметры:
//  Параметры - см. ПараметрыФайлов
//
// Возвращаемое значение:
//  см. НовыйРезультатПорции
//
Функция ЗагрузитьФайлыВБазу(Параметры) Экспорт

	Возврат ОбработатьПорциюФайлов(Параметры, Истина);

КонецФункции

// Отвязывает информационную базу от томов: новые файлы хранятся в базе, у томов
// очищаются пути. Тома, на которых еще есть файлы, по умолчанию не трогаются: такие
// файлы остаются недоступными (например, файлы, которых нет в хранилище).
//
// Параметры:
//  ТолькоПроверка - Булево - только показать, что будет сделано.
//  ВключаяТомаСФайлами - Булево - отвязать и тома, на которых остались файлы.
//
// Возвращаемое значение:
//  Структура:
//   * СпособХранения - Строка - "ВИнформационнойБазе" после выполнения
//   * ОтвязаноТомов - Число
//   * ТомаСФайлами - Массив из Строка
//
Функция ОтвязатьТома(ТолькоПроверка = Истина, ВключаяТомаСФайлами = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Сводка = СводкаФайловНаТомах();
	ТомаСФайлами = Новый Массив;
	Для Каждого ОписаниеТома Из Сводка.Тома Цикл
		ТомаСФайлами.Добавить(ОписаниеТома.Том);
	КонецЦикла;
	
	Результат = Новый Структура("СпособХранения, ОтвязаноТомов, ТомаСФайлами",
		СпособХраненияФайлов(), 0, ТомаСФайлами);
	
	Если Метаданные.Справочники.Найти("ТомаХраненияФайлов") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ТолькоПроверка Тогда
		УстановитьХранениеВИнформационнойБазе();
		Результат.СпособХранения = СпособХраненияФайлов();
	КонецЕсли;
	
	Выборка = Справочники.ТомаХраненияФайлов.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ВключаяТомаСФайлами И ТомаСФайлами.Найти(Строка(Выборка.Ссылка)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(Выборка.ПолныйПутьWindows) И ПустаяСтрока(Выборка.ПолныйПутьLinux) Тогда
			Продолжить;
		КонецЕсли;
		Результат.ОтвязаноТомов = Результат.ОтвязаноТомов + 1;
		Если ТолькоПроверка Тогда
			Продолжить;
		КонецЕсли;
		ТомОбъект = Выборка.ПолучитьОбъект();
		ЗаписатьВЖурнал(СтрШаблон("Том ""%1"" отвязан от каталога ""%2"".", ТомОбъект.Наименование,
			СокрЛП(ТомОбъект.ПолныйПутьWindows + " " + ТомОбъект.ПолныйПутьLinux)));
		ТомОбъект.ПолныйПутьWindows = "";
		ТомОбъект.ПолныйПутьLinux = "";
		ТомОбъект.ОбменДанными.Загрузка = Истина;
		ТомОбъект.Записать();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроводкиУдаляемыхДокументов

// Параметры методов перевода движений документов в операции.
//
// Возвращаемое значение:
//  Структура:
//   * ВидыДокументов - Массив из Строка - имена документов, например "ad_НачислениеПроцентовПоЗаймам".
//   * Регистры - Массив из Строка - полные имена регистров, движения которых переносятся;
//                пусто - все регистры, которые есть в движениях операции и не исключены.
//   * ИсключитьРегистры - Массив из Строка - префиксы имен регистров, которые не переносятся
//                         (регистры удаляемой части конфигурации).
//   * Порция - Число - сколько документов обработать за вызов.
//   * Позиция - Число - сколько документов пропустить с начала списка.
//
Функция ПараметрыПроводок() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ВидыДокументов", Новый Массив);
	Параметры.Вставить("Регистры", Новый Массив);
	Параметры.Вставить("ИсключитьРегистры", Новый Массив);
	Параметры.Вставить("Порция", 50);
	Параметры.Вставить("Позиция", 0);
	Возврат Параметры;

КонецФункции

// Виды документов, у которых есть движения по регистрам бухгалтерии и накопления.
//
// Параметры:
//  Префиксы - Массив из Строка - префиксы имен, по которым вид предлагается к переносу;
//             виды из расширений предлагаются всегда.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Документ - Строка - имя
//   * Представление - Строка
//   * Документов - Число - документов с движениями
//   * Движений - Число
//   * Регистры - Строка - регистры с движениями через запятую
//   * ИзРасширения - Булево
//   * Предлагается - Булево - вид похож на удаляемый (префикс или расширение)
//
Функция ВидыДокументовСДвижениями(Префиксы = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Итоги = Новый Соответствие;
	Для Каждого ОписаниеРегистра Из РегистрыСДвижениями() Цикл
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.Регистратор КАК Регистратор,
		|	КОЛИЧЕСТВО(*) КАК Движений
		|ИЗ
		|	" + ОписаниеРегистра.ПолноеИмя + " КАК Т
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.Регистратор");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МетаданныеДокумента = Выборка.Регистратор.Метаданные();
			Итог = Итоги.Получить(МетаданныеДокумента);
			Если Итог = Неопределено Тогда
				Итог = Новый Структура("Документы, Движений, Регистры", Новый Соответствие, 0, Новый Соответствие);
				Итоги.Вставить(МетаданныеДокумента, Итог);
			КонецЕсли;
			Итог.Документы.Вставить(Выборка.Регистратор, Истина);
			Итог.Движений = Итог.Движений + Выборка.Движений;
			Итог.Регистры.Вставить(ОписаниеРегистра.Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Итоги Цикл
		МетаданныеДокумента = КлючИЗначение.Ключ;
		ИменаРегистров = Новый Массив;
		Для Каждого Регистр Из КлючИЗначение.Значение.Регистры Цикл
			ИменаРегистров.Добавить(Регистр.Ключ);
		КонецЦикла;
		ИзРасширения = МетаданныеДокумента.РасширениеКонфигурации() <> Неопределено;
		Результат.Добавить(Новый Структура("Документ, Представление, Документов, Движений, Регистры, ИзРасширения, Предлагается",
			МетаданныеДокумента.Имя, МетаданныеДокумента.Представление(),
			КлючИЗначение.Значение.Документы.Количество(), КлючИЗначение.Значение.Движений,
			СтрСоединить(ИменаРегистров, ", "), ИзРасширения,
			ИзРасширения Или ИмяНачинаетсяС(МетаданныеДокумента.Имя, Префиксы)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет перенос: какие документы будут перенесены, какие движения не переносятся.
// Ничего не меняет.
//
// Параметры:
//  Параметры - см. ПараметрыПроводок
//
// Возвращаемое значение:
//  см. НовыйРезультатПорции
//
Функция ПроверитьПереносПроводок(Параметры) Экспорт

	Возврат ОбработатьПорциюДокументов(Параметры, Ложь);

КонецФункции

// Выполняет код на сервере и возвращает переменную Результат. Для скриптов, которые работают
// через COM-соединение: без клиента 1С и его стартовых окон.
//
// Параметры:
//  Код - Строка
//
// Возвращаемое значение:
//  Произвольный - значение переменной Результат
//
Функция ВыполнитьКод(Код) Экспорт

	Результат = Неопределено;
	Выполнить(Код);
	Возврат Результат;

КонецФункции

// Переносит движения документов в документы "Операция (бух)", очищает движения документов
// и помечает документы на удаление.
// Каждый документ - отдельная транзакция; движения операции сверяются с движениями документа.
// Перенесенный документ помечен на удаление и в следующие вызовы не попадает.
//
// Параметры:
//  Параметры - см. ПараметрыПроводок
//
// Возвращаемое значение:
//  см. НовыйРезультатПорции
//
Функция ПеренестиПроводкиВОперации(Параметры) Экспорт

	Возврат ОбработатьПорциюДокументов(Параметры, Истина);

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Файлы

Функция ОбработатьПорциюФайлов(Параметры, Загружать)

	УстановитьПривилегированныйРежим(Истина);

	Параметры = ДополнитьПараметры(Параметры, ПараметрыФайлов());
	Подмена = РазобратьПодменуПутей(Параметры.ПодменаПутей);
	Результат = НовыйРезультатПорции(Параметры.Позиция);

	Файлы = СписокФайловНаТомах();
	Результат.Всего = Файлы.Количество();

	Индекс = Параметры.Позиция;
	ОбъемПорции = 0;
	Пока Индекс < Файлы.Количество() И Результат.Обработано < Параметры.Порция
		И (Не Загружать Или ОбъемПорции < Параметры.ПорцияМБ * 1024 * 1024) Цикл
		ОписаниеФайла = Файлы[Индекс];
		Индекс = Индекс + 1;
		Результат.Обработано = Результат.Обработано + 1;
		ОбъемПорции = ОбъемПорции + ОписаниеФайла.Размер;

		ПутьНаТоме = ПолноеИмяФайлаВТоме(ОписаниеФайла.Том, ОписаниеФайла.ПутьКФайлу);
		Путь = ПрименитьПодмену(ПутьНаТоме, Подмена);
		Попытка
			ПроверитьФайл(Путь, ОписаниеФайла.Размер, Параметры.СверятьРазмер);
			Если Загружать Тогда
				ЗагрузитьФайл(ОписаниеФайла.Ссылка, Новый ДвоичныеДанные(Путь));
				ЗаписатьВЖурнал(СтрШаблон("Файл загружен в базу из ""%1"".", ПутьНаТоме), ОписаниеФайла.Ссылка);
			КонецЕсли;
			Результат.Успешно = Результат.Успешно + 1;
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибок = Результат.Ошибок + 1;
			Если Результат.Ошибки.Количество() < 100 Тогда
				Результат.Ошибки.Добавить(Новый Структура("Объект, Владелец, Файл, Путь, Ошибка",
					ОписаниеФайла.Справочник + " " + Строка(ОписаниеФайла.Ссылка.УникальныйИдентификатор()),
					ОписаниеВладельца(ОписаниеФайла.Владелец), ОписаниеФайла.ИмяФайла, Путь, ТекстОшибки));
			КонецЕсли;
			Если Загружать Тогда
				ЗаписатьВЖурнал(СтрШаблон("Файл не загружен из ""%1"": %2", Путь, ТекстОшибки), ОписаниеФайла.Ссылка,
					УровеньЖурналаРегистрации.Ошибка);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	// Загруженные файлы уходят из списка, поэтому при загрузке позиция сдвигается
	// только на файлы с ошибкой.
	Результат.Позиция = Параметры.Позиция + ?(Загружать, Результат.Ошибок, Результат.Обработано);
	Результат.Завершено = Индекс >= Файлы.Количество();
	Возврат Результат;

КонецФункции

Функция СписокФайловНаТомах()

	Тексты = Новый Массив;
	Для Каждого ИмяСправочника Из СправочникиФайлов() Цикл
		Тексты.Добавить(СтрЗаменить(
		"ВЫБРАТЬ
		|	""&Справочник"" КАК Справочник,
		|	Т.Ссылка КАК Ссылка,
		|	Т.Том КАК Том,
		|	Т.ПутьКФайлу КАК ПутьКФайлу,
		|	Т.Размер КАК Размер,
		|	Т.Наименование + ВЫБОР КОГДА Т.Расширение = """" ТОГДА """" ИНАЧЕ ""."" + Т.Расширение КОНЕЦ КАК ИмяФайла,
		|	&Владелец КАК Владелец
		|ИЗ
		|	&Справочник КАК Т
		|ГДЕ
		|	Т.ТипХраненияФайла = ЗНАЧЕНИЕ(Перечисление.ТипыХраненияФайлов.ВТомахНаДиске)", "&Справочник", ИмяСправочника));
		Тексты[Тексты.ВГраница()] = СтрЗаменить(Тексты[Тексты.ВГраница()], "&Владелец",
			?(СтрЗаканчиваетсяНа(ИмяСправочника, ".ВерсииФайлов"), "Т.Владелец.ВладелецФайла", "Т.ВладелецФайла"));
	КонецЦикла;

	Если Тексты.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

	Запрос = Новый Запрос(СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО Справочник, Ссылка");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Справочники присоединенных файлов, которые могут хранить файл в томе. Как в обработке БСП
// "Перенос файлов": версии файлов вместо справочников-владельцев версий.
Функция СправочникиФайлов()

	Имена = Новый СписокЗначений;
	МетаданныеВерсий = Метаданные.Справочники.Найти("ВерсииФайлов");
	ВладельцыВерсий = ?(МетаданныеВерсий = Неопределено, Неопределено, МетаданныеВерсий.СтандартныеРеквизиты.Владелец.Тип);

	ОпределяемыйТип = Метаданные.ОпределяемыеТипы.Найти("ПрисоединенныйФайл");
	Если ОпределяемыйТип = Неопределено Тогда
		Кандидаты = Метаданные.Справочники;
	Иначе
		Кандидаты = Новый Массив;
		Для Каждого ТипФайла Из ОпределяемыйТип.Тип.Типы() Цикл
			Кандидаты.Добавить(Метаданные.НайтиПоТипу(ТипФайла));
		КонецЦикла;
		Если МетаданныеВерсий <> Неопределено Тогда
			Кандидаты.Добавить(МетаданныеВерсий);
		КонецЕсли;
	КонецЕсли;

	Для Каждого ОбъектМетаданных Из Кандидаты Цикл
		Если ОбъектМетаданных = Неопределено
			Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных)
			Или ОбъектМетаданных.Имя = "ИдентификаторыОбъектовМетаданных"
			Или ОбъектМетаданных.Реквизиты.Найти("Том") = Неопределено
			Или ОбъектМетаданных.Реквизиты.Найти("ПутьКФайлу") = Неопределено
			Или ОбъектМетаданных.Реквизиты.Найти("ТипХраненияФайла") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ВладельцыВерсий <> Неопределено И ОбъектМетаданных <> МетаданныеВерсий
			И ВладельцыВерсий.СодержитТип(Тип("СправочникСсылка." + ОбъектМетаданных.Имя)) Тогда
			Продолжить;
		КонецЕсли;
		Если Имена.НайтиПоЗначению(ОбъектМетаданных.ПолноеИмя()) = Неопределено Тогда
			Имена.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;

	Имена.СортироватьПоЗначению();
	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

Функция ОписаниеВладельца(Владелец)
	
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("%1 (%2)", Строка(Владелец), Владелец.Метаданные().Представление());
	
КонецФункции

Функция ПутьТома(Том)

	Если Не ЗначениеЗаполнено(Том) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(?(ЭтоWindows(), Том.ПолныйПутьWindows, Том.ПолныйПутьLinux));

КонецФункции

// Как РаботаСФайламиВТомахСлужебный.ПолноеИмяФайлаВТоме для файла с заполненным путем.
Функция ПолноеИмяФайлаВТоме(Том, ПутьКФайлу)

	Если Не ЗначениеЗаполнено(Том) Тогда
		ВызватьИсключение "У файла не указан том.";
	КонецЕсли;
	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ВызватьИсключение "У файла не указан путь в томе.";
	КонецЕсли;
	Возврат ПутьТома(Том) + ПутьКФайлу;

КонецФункции

Функция РазобратьПодменуПутей(Строки)

	Подмена = Новый Массив;
	Для Каждого СтрокаПодмены Из Строки Цикл
		Части = СтрРазделить(СтрокаПодмены, "=>", Ложь);
		Если Части.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Части.Количество() <> 2 Тогда
			ВызватьИсключение СтрШаблон("Подмена пути должна иметь вид ""откуда => куда"": %1", СтрокаПодмены);
		КонецЕсли;
		Подмена.Добавить(Новый Структура("Откуда, Куда", СокрЛП(Части[0]), СокрЛП(Части[1])));
	КонецЦикла;
	Возврат Подмена;

КонецФункции

Функция ПрименитьПодмену(Путь, Подмена)

	Для Каждого Правило Из Подмена Цикл
		Если НРег(Лев(Путь, СтрДлина(Правило.Откуда))) = НРег(Правило.Откуда) Тогда
			Возврат Правило.Куда + Сред(Путь, СтрДлина(Правило.Откуда) + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Путь;

КонецФункции

Процедура ПроверитьФайл(Путь, Размер, СверятьРазмер)

	ФайлНаДиске = Новый Файл(Путь);
	Если Не ФайлНаДиске.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл не найден: %1", Путь);
	КонецЕсли;
	Если СверятьРазмер И ЗначениеЗаполнено(Размер) И ФайлНаДиске.Размер() <> Размер Тогда
		ВызватьИсключение СтрШаблон("Размер файла %1 байт, в базе %2 байт: %3",
			Формат(ФайлНаДиске.Размер(), "ЧГ=0"), Формат(Размер, "ЧГ=0"), Путь);
	КонецЕсли;

КонецПроцедуры

// Порядок как в обработке БСП "Перенос файлов" (ПеренестиВБазу): сначала у элемента
// меняется тип хранения, потом двоичные данные пишутся в хранилище по параметрам
// уже измененного элемента. Файл с тома не удаляется. Элемент пишется в режиме загрузки:
// обычная запись запускала логику конфигурации (БИТ: документы трансляции отчетов
// в бюджетирование, статусы отчетности), а меняется здесь только место хранения.
Процедура ЗагрузитьФайл(Ссылка, ДанныеФайла)

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
		Блокировка.Заблокировать();

		ФайлОбъект = Ссылка.ПолучитьОбъект();
		Если ФайлОбъект.ТипХраненияФайла <> Перечисления.ТипыХраненияФайлов.ВТомахНаДиске Тогда
			ВызватьИсключение "Файл уже не хранится в томе.";
		КонецЕсли;
		ФайлОбъект.Том = Неопределено;
		ФайлОбъект.ПутьКФайлу = "";
		ФайлОбъект.ТипХраненияФайла = Перечисления.ТипыХраненияФайлов.ВИнформационнойБазе;
		ФайлОбъект.ОбменДанными.Загрузка = Истина;
		ФайлОбъект.Записать();

		ЗаписатьДвоичныеДанныеВБазу(ФайлОбъект, ДанныеФайла);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// В БСП 3.1.10+ запись требует параметров записи (РаботаСФайловымАрхивомСервер),
// в более ранних версиях - только ссылку и данные. Вызов через Выполнить, чтобы
// обработка компилировалась на любой версии.
Процедура ЗаписатьДвоичныеДанныеВБазу(ФайлОбъект, ДанныеФайла)

	Ссылка = ФайлОбъект.Ссылка;
	Если Метаданные.ОбщиеМодули.Найти("РаботаСФайловымАрхивомСервер") <> Неопределено Тогда
		ПараметрыЗаписи = Неопределено;
		Выполнить("ПараметрыЗаписи = РаботаСФайловымАрхивомСервер.ЗаполненныеПараметрыЗаписиВИнформационнуюБазу(ФайлОбъект)");
		Выполнить("РаботаСФайламиСлужебный.ЗаписатьФайлВИнформационнуюБазу(Ссылка, ДанныеФайла, ПараметрыЗаписи)");
	Иначе
		Выполнить("РаботаСФайламиСлужебный.ЗаписатьФайлВИнформационнуюБазу(Ссылка, ДанныеФайла)");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Проводки

Функция ОбработатьПорциюДокументов(Параметры, Переносить)

	УстановитьПривилегированныйРежим(Истина);

	Параметры = ДополнитьПараметры(Параметры, ПараметрыПроводок());
	Если Метаданные.Документы.Найти("ОперацияБух") = Неопределено Тогда
		ВызватьИсключение "В конфигурации нет документа ""Операция (бух)"" (ОперацияБух).";
	КонецЕсли;

	Регистры = РегистрыДляПереноса(Параметры);
	Результат = НовыйРезультатПорции(Параметры.Позиция);
	Результат.Вставить("Движений", 0);
	Результат.Вставить("НеПереносится", Новый Соответствие);

	СписокДокументов = ДокументыДляПереноса(Параметры.ВидыДокументов, Регистры);
	Результат.Всего = СписокДокументов.Количество();

	Индекс = Параметры.Позиция;
	Пока Индекс < СписокДокументов.Количество() И Результат.Обработано < Параметры.Порция Цикл
		Документ = СписокДокументов[Индекс];
		Индекс = Индекс + 1;
		Результат.Обработано = Результат.Обработано + 1;
		Попытка
			Перенесено = ПеренестиДокумент(Документ, Регистры, Переносить, Результат.НеПереносится);
			Результат.Движений = Результат.Движений + Перенесено;
			Результат.Успешно = Результат.Успешно + 1;
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибок = Результат.Ошибок + 1;
			Если Результат.Ошибки.Количество() < 100 Тогда
				Результат.Ошибки.Добавить(Новый Структура("Объект, Владелец, Файл, Путь, Ошибка", Строка(Документ), "", "", "", ТекстОшибки));
			КонецЕсли;
			Если Переносить Тогда
				ЗаписатьВЖурнал("Движения не перенесены: " + ТекстОшибки, Документ, УровеньЖурналаРегистрации.Ошибка);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	// Перенесенные документы помечены на удаление и уходят из списка.
	Результат.Позиция = Параметры.Позиция + ?(Переносить, Результат.Ошибок, Результат.Обработано);
	Результат.Завершено = Индекс >= СписокДокументов.Количество();

	НеПереносится = Новый Массив;
	Для Каждого КлючИЗначение Из Результат.НеПереносится Цикл
		НеПереносится.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Результат.НеПереносится = СтрСоединить(НеПереносится, ", ");
	Возврат Результат;

КонецФункции

// Регистры, движения которых переносятся: есть в движениях операции, не исключены и,
// если список задан, входят в него.
Функция РегистрыДляПереноса(Параметры)

	Регистры = Новый Массив;
	Для Каждого Регистр Из Метаданные.Документы.ОперацияБух.Движения Цикл
		ПолноеИмя = Регистр.ПолноеИмя();
		Если Параметры.Регистры.Количество() > 0 И Параметры.Регистры.Найти(ПолноеИмя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяНачинаетсяС(Регистр.Имя, Параметры.ИсключитьРегистры) Тогда
			Продолжить;
		КонецЕсли;
		Регистры.Добавить(Регистр);
	КонецЦикла;
	Возврат Регистры;

КонецФункции

// Непомеченные документы выбранных видов, у которых есть движения по переносимым регистрам.
Функция ДокументыДляПереноса(ВидыДокументов, Регистры)

	Тексты = Новый Массив;
	Для Каждого ИмяДокумента Из ВидыДокументов Цикл
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаданныеДокумента = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Документ ""%1"" не найден.", ИмяДокумента);
		КонецЕсли;
		Для Каждого Регистр Из Регистры Цикл
			Если Не МетаданныеДокумента.Движения.Содержит(Регистр) Тогда
				Продолжить;
			КонецЕсли;
			Тексты.Добавить(СтрШаблон(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Т.Регистратор КАК Ссылка
			|ИЗ
			|	%1 КАК Т
			|ГДЕ
			|	Т.Регистратор ССЫЛКА %2
			|	И НЕ Т.Регистратор.ПометкаУдаления", Регистр.ПолноеИмя(), МетаданныеДокумента.ПолноеИмя()));
		КонецЦикла;
	КонецЦикла;

	Если Тексты.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Ссылка.Дата КАК Дата
	|ИЗ
	|	(" + СтрСоединить(Тексты, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС) + ") КАК Д
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Ссылка");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Создает операцию с движениями документа по переносимым регистрам, сверяет движения
// и помечает документ на удаление (это отменяет его проведение и удаляет его движения).
// Возвращает число перенесенных движений.
Функция ПеренестиДокумент(Документ, Регистры, Переносить, НеПереносится)

	ДокументОбъект = Документ.ПолучитьОбъект();
	МетаданныеДокумента = ДокументОбъект.Метаданные();

	Наборы = Новый Массив;
	Движений = 0;
	Для Каждого НаборЗаписей Из ДокументОбъект.Движения Цикл
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеРегистра = НаборЗаписей.Метаданные();
		Если Регистры.Найти(МетаданныеРегистра) = Неопределено Тогда
			НеПереносится.Вставить(МетаданныеРегистра.ПолноеИмя(), Истина);
			Продолжить;
		КонецЕсли;
		Наборы.Добавить(НаборЗаписей);
		Движений = Движений + НаборЗаписей.Количество();
	КонецЦикла;

	Если Не Переносить Тогда
		Возврат Движений;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Операция = Документы.ОперацияБух.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(Операция, ДокументОбъект, "Дата, Организация, Ответственный");
		Описание = СтрШаблон("Перенесено из документа ""%1"" (%2, %3)", Строка(Документ),
			МетаданныеДокумента.Имя, Строка(Документ.УникальныйИдентификатор()));
		УстановитьРеквизит(Операция, "Содержание", Строка(Документ));
		УстановитьРеквизит(Операция, "Комментарий", Описание);

		СуммаОперации = 0;
		Для Каждого НаборЗаписей Из Наборы Цикл
			МетаданныеРегистра = НаборЗаписей.Метаданные();
			Приемник = Операция.Движения[МетаданныеРегистра.Имя];
			Приемник.Загрузить(НаборЗаписей.Выгрузить());
			Приемник.Записывать = Истина;
			ДобавитьРегистрВТаблицуОперации(Операция, МетаданныеРегистра);
			Если Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеРегистра)
				И МетаданныеРегистра.Ресурсы.Найти("Сумма") <> Неопределено Тогда
				Движения = НаборЗаписей.Выгрузить();
				Для Каждого ИмяКолонки Из КолонкиРесурса(Движения, "Сумма") Цикл
					СуммаОперации = СуммаОперации + Движения.Итог(ИмяКолонки);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		УстановитьРеквизит(Операция, "СуммаОперации", СуммаОперации);
		Операция.Записать();

		СверитьДвижения(Наборы, Операция.Ссылка);
		
		// Отмена проведения не у всех документов удаляет движения ("Удаление движений" -
		// "Не удалять автоматически"): движения очищаются явно, иначе проводки задвоятся.
		Для Каждого НаборЗаписей Из ДокументОбъект.Движения Цикл
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
		КонецЦикла;
		ДокументОбъект.УстановитьПометкуУдаления(Истина);
		ПроверитьОтсутствиеДвижений(Документ, Наборы);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписатьВЖурнал(СтрШаблон("Движения (%1) перенесены в операцию ""%2"", документ помечен на удаление.",
		Движений, Строка(Операция.Ссылка)), Документ);
	Возврат Движений;

КонецФункции

// У документа после переноса не должно остаться движений по перенесенным регистрам.
Процедура ПроверитьОтсутствиеДвижений(Документ, Наборы)
	
	Для Каждого НаборДокумента Из Наборы Цикл
		МетаданныеРегистра = НаборДокумента.Метаданные();
		Набор = РегистрМенеджер(МетаданныеРегистра).СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Документ);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон("%1: у документа осталось движений %2.", МетаданныеРегистра.Имя, Набор.Количество());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Движения операции должны совпадать с движениями документа по количеству и ресурсам.
Процедура СверитьДвижения(Наборы, Операция)

	Для Каждого НаборДокумента Из Наборы Цикл
		МетаданныеРегистра = НаборДокумента.Метаданные();
		НаборОперации = РегистрМенеджер(МетаданныеРегистра).СоздатьНаборЗаписей();
		НаборОперации.Отбор.Регистратор.Установить(Операция);
		НаборОперации.Прочитать();

		ДвиженияДокумента = НаборДокумента.Выгрузить();
		ДвиженияОперации = НаборОперации.Выгрузить();
		Если ДвиженияДокумента.Количество() <> ДвиженияОперации.Количество() Тогда
			ВызватьИсключение СтрШаблон("%1: движений у документа %2, у операции %3.", МетаданныеРегистра.Имя,
				ДвиженияДокумента.Количество(), ДвиженияОперации.Количество());
		КонецЕсли;
		Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
			Если Не Ресурс.Тип.СодержитТип(Тип("Число")) Тогда
				Продолжить;
			КонецЕсли;
			// У регистра бухгалтерии ресурс с признаком учета "Балансовый = Ложь" выгружается
			// колонками <Имя>Дт и <Имя>Кт.
			Для Каждого ИмяКолонки Из КолонкиРесурса(ДвиженияДокумента, Ресурс.Имя) Цикл
				Если ДвиженияДокумента.Итог(ИмяКолонки) <> ДвиженияОперации.Итог(ИмяКолонки) Тогда
					ВызватьИсключение СтрШаблон("%1.%2: у документа %3, у операции %4.", МетаданныеРегистра.Имя,
						ИмяКолонки, ДвиженияДокумента.Итог(ИмяКолонки), ДвиженияОперации.Итог(ИмяКолонки));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция КолонкиРесурса(Таблица, ИмяРесурса)
	
	Колонки = Новый Массив;
	Для Каждого ИмяКолонки Из СтрРазделить(ИмяРесурса + "," + ИмяРесурса + "Дт," + ИмяРесурса + "Кт", ",") Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Колонки.Добавить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	Возврат Колонки;
	
КонецФункции

// В БП у операции есть табличные части со списком регистров накопления и сведений,
// движения которых она содержит: без них форма операции эти движения не показывает.
Процедура ДобавитьРегистрВТаблицуОперации(Операция, МетаданныеРегистра)

	Если Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
		ИмяТаблицы = "ТаблицаРегистровНакопления";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		ИмяТаблицы = "ТаблицаРегистровСведений";
	Иначе
		Возврат;
	КонецЕсли;
	Если Операция.Метаданные().ТабличныеЧасти.Найти(ИмяТаблицы) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Операция[ИмяТаблицы];
	Если Таблица.Найти(МетаданныеРегистра.Имя, "Имя") = Неопределено Тогда
		Таблица.Добавить().Имя = МетаданныеРегистра.Имя;
	КонецЕсли;

КонецПроцедуры

// Регистры бухгалтерии и накопления, в которых документы пишут движения.
Функция РегистрыСДвижениями()

	Регистры = Новый Массив;
	Для Каждого Регистр Из Метаданные.РегистрыБухгалтерии Цикл
		Регистры.Добавить(Новый Структура("Имя, ПолноеИмя", Регистр.Имя, Регистр.ПолноеИмя()));
	КонецЦикла;
	Для Каждого Регистр Из Метаданные.РегистрыНакопления Цикл
		Регистры.Добавить(Новый Структура("Имя, ПолноеИмя", Регистр.Имя, Регистр.ПолноеИмя()));
	КонецЦикла;
	Возврат Регистры;

КонецФункции

Функция РегистрМенеджер(МетаданныеРегистра)

	Если Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыБухгалтерии[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыНакопления[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыСведений[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыРасчета[МетаданныеРегистра.Имя];
	КонецЕсли;
	ВызватьИсключение "Неизвестный вид регистра: " + МетаданныеРегистра.ПолноеИмя();

КонецФункции

Процедура УстановитьРеквизит(Объект, Имя, Значение)

	Если Объект.Метаданные().Реквизиты.Найти(Имя) <> Неопределено Тогда
		Объект[Имя] = Значение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Общие

// Результат вызова, который обрабатывает список порциями.
//
// Возвращаемое значение:
//  Структура:
//   * Всего - Число - объектов в списке на момент вызова
//   * Обработано - Число
//   * Успешно - Число
//   * Ошибок - Число
//   * Ошибки - Массив из Структура: Объект, Владелец, Файл, Путь, Ошибка (первые 100)
//   * Позиция - Число - передать в следующий вызов
//   * Завершено - Булево
//
Функция НовыйРезультатПорции(Позиция)

	Результат = Новый Структура;
	Результат.Вставить("Всего", 0);
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Успешно", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Позиция", Позиция);
	Результат.Вставить("Завершено", Ложь);
	Возврат Результат;

КонецФункции

Функция ДополнитьПараметры(Параметры, ПоУмолчанию)

	Если Параметры = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Для Каждого КлючИЗначение Из Параметры Цикл
		ПоУмолчанию.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

Функция ИмяНачинаетсяС(Имя, Префиксы)

	Если Префиксы = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Префикс Из Префиксы Цикл
		Если Не ПустаяСтрока(Префикс) И НРег(Лев(Имя, СтрДлина(Префикс))) = НРег(Префикс) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЗначениеКонстанты(Имя)

	Если Метаданные.Константы.Найти(Имя) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Константы[Имя].Получить();

КонецФункции

// Способ хранения новых файлов. В БСП до 3.1.5 - только константа ХранитьФайлыВТомахНаДиске.
Функция СпособХраненияФайлов()
	
	Способ = ЗначениеКонстанты("СпособХраненияФайлов");
	Если ЗначениеЗаполнено(Способ) Тогда
		Возврат Строка(Способ);
	КонецЕсли;
	Возврат ?(ЗначениеКонстанты("ХранитьФайлыВТомахНаДиске") = Истина, "ВТомахНаДиске", "ВИнформационнойБазе");
	
КонецФункции

Процедура УстановитьХранениеВИнформационнойБазе()
	
	Если СпособХраненияФайлов() = "ВИнформационнойБазе" Тогда
		Возврат;
	КонецЕсли;
	Если Метаданные.Константы.Найти("СпособХраненияФайлов") <> Неопределено Тогда
		Константы.СпособХраненияФайлов.Установить("ВИнформационнойБазе");
	КонецЕсли;
	Если Метаданные.Константы.Найти("ХранитьФайлыВТомахНаДиске") <> Неопределено Тогда
		Константы.ХранитьФайлыВТомахНаДиске.Установить(Ложь);
	КонецЕсли;
	ЗаписатьВЖурнал("Новые файлы хранятся в информационной базе.");
	
КонецПроцедуры

Функция ЭтоWindows()

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Платформа = СистемнаяИнформация.ТипПлатформы;
	Возврат Платформа = ТипПлатформы.Windows_x86 Или Платформа = ТипПлатформы.Windows_x86_64;

КонецФункции

Процедура ЗаписатьВЖурнал(Текст, Данные = Неопределено, Уровень = Неопределено)

	ЗаписьЖурналаРегистрации("ПодготовкаКопииПослеВыделения",
		?(Уровень = Неопределено, УровеньЖурналаРегистрации.Информация, Уровень),
		?(Данные = Неопределено, Неопределено, Данные.Метаданные()), Данные, Текст);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
