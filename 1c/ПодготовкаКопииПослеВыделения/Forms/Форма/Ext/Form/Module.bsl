#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПорцияФайлов = 200;
	ПрефиксыДокументов = "бит_, ad_";
	ИсключитьРегистры = "бит_";
	ЗаполнитьТома(ОбъектОбработки().СводкаФайловНаТомах(), Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСводку(Команда)

	ОбновитьСводкуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДоступ(Команда)

	ПроверитьДоступНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьУчетныеДанные(Команда)

	Если ПустаяСтрока(СерверХранилища) Или ПустаяСтрока(ПользовательХранилища) Тогда
		ПоказатьПредупреждение(, "Укажите сервер и пользователя хранилища.");
		Возврат;
	КонецЕсли;
	КодВозврата = СохранитьУчетныеДанныеНаСервере(СерверХранилища, ПользовательХранилища, ПарольХранилища);
	ПарольХранилища = "";
	ДобавитьВПротокол(Протокол, СтрШаблон("cmdkey для %1 (%2): код возврата %3.", СерверХранилища, ПользовательХранилища, КодВозврата));
	ПроверитьДоступНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФайлы(Команда)

	ВыполнитьПорциями("ПроверитьФайлыНаТомах", "Проверка файлов");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлы(Команда)

	ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьФайлыЗавершение", ЭтотОбъект),
		"Загрузить файлы с томов в информационную базу? Файлы на томах останутся без изменений.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлыЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьПорциями("ЗагрузитьФайлыВБазу", "Загрузка файлов");
		ОбновитьСводкуНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьТома(Команда)
	
	Проверка = ОтвязатьТомаНаСервере(Истина, Истина);
	Если Проверка.ТомаСФайлами.Количество() = 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтвязатьТомаЗавершение", ЭтотОбъект, Ложь),
			СтрШаблон("Хранить новые файлы в информационной базе и очистить пути томов (%1)?", Проверка.ОтвязаноТомов),
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(Истина, "Отвязать все тома");
	Кнопки.Добавить(Ложь, "Только тома без файлов");
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, "Отмена");
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтвязатьТомаЗавершение", ЭтотОбъект, Неопределено),
		"На томах остались файлы (" + СтрСоединить(Проверка.ТомаСФайлами, ", ") + "). Если их нет в хранилище "
		+ "(см. ""Проверить файлы""), тома можно отвязать: эти файлы и так недоступны.", Кнопки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтвязатьТомаЗавершение(Ответ, ВключаяТомаСФайлами) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Ответ = ВключаяТомаСФайлами;
	КонецЕсли;
	Если ТипЗнч(Ответ) <> Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	Результат = ОтвязатьТомаНаСервере(Ложь, Ответ);
	ДобавитьВПротокол(Протокол, СтрШаблон("Отвязано томов: %1, способ хранения новых файлов: %2.", Результат.ОтвязаноТомов,
		Результат.СпособХранения));
	ОбновитьСводкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВидыДокументов(Команда)

	ЗаполнитьВидыДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПеренос(Команда)

	Если ПроверитьВыборВидов() Тогда
		ВыполнитьПорциями("ПроверитьПереносПроводок", "Проверка переноса");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПроводки(Команда)

	Если Не ПроверитьВыборВидов() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПеренестиПроводкиЗавершение", ЭтотОбъект),
		"Перенести движения отмеченных видов документов в операции и пометить документы на удаление?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПроводкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьПорциями("ПеренестиПроводкиВОперации", "Перенос проводок");
		ЗаполнитьВидыДокументовНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывает метод обработки порциями, пока он не сообщит о завершении.
&НаКлиенте
Процедура ВыполнитьПорциями(ИмяМетода, Действие)

	Позиция = 0;
	Итог = Новый Структура("Обработано, Успешно, Ошибок, Движений", 0, 0, 0, 0);
	НеПереносится = "";
	Пока Истина Цикл
		Результат = ВызватьМетодНаСервере(ИмяМетода, Позиция);
		Итог.Обработано = Итог.Обработано + Результат.Обработано;
		Итог.Успешно = Итог.Успешно + Результат.Успешно;
		Итог.Ошибок = Итог.Ошибок + Результат.Ошибок;
		Если Результат.Свойство("Движений") Тогда
			Итог.Движений = Итог.Движений + Результат.Движений;
			НеПереносится = Результат.НеПереносится;
		КонецЕсли;
		Для Каждого Ошибка Из Результат.Ошибки Цикл
			ДобавитьВПротокол(Протокол, ?(ПустаяСтрока(Ошибка.Владелец),
				СтрШаблон("%1: %2", Ошибка.Объект, Ошибка.Ошибка),
				СтрШаблон("%1, файл ""%2"": %3", Ошибка.Владелец, Ошибка.Файл, Ошибка.Ошибка)));
		КонецЦикла;
		Состояние(Действие, ?(Результат.Всего = 0, 100, Окр(100 * Итог.Обработано / Макс(Результат.Всего, 1))),
			СтрШаблон("Обработано %1, ошибок %2", Итог.Обработано, Итог.Ошибок));
		Позиция = Результат.Позиция;
		Если Результат.Завершено Или Результат.Обработано = 0 Тогда
			Прервать;
		КонецЕсли;
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

	Текст = СтрШаблон("%1: обработано %2, успешно %3, ошибок %4.", Действие, Итог.Обработано, Итог.Успешно, Итог.Ошибок);
	Если Итог.Движений > 0 Тогда
		Текст = Текст + СтрШаблон(" Движений: %1.", Итог.Движений);
	КонецЕсли;
	Если Не ПустаяСтрока(НеПереносится) Тогда
		Текст = Текст + " Не переносятся регистры: " + НеПереносится + ".";
	КонецЕсли;
	ДобавитьВПротокол(Протокол, Текст);

КонецПроцедуры

&НаСервере
Функция ВызватьМетодНаСервере(ИмяМетода, Позиция)

	Обработка = ОбъектОбработки();
	Если СтрНайти(ИмяМетода, "Файл") > 0 Тогда
		Параметры = Обработка.ПараметрыФайлов();
		Параметры.ПодменаПутей = СтрРазделить(ПодменаПутей, Символы.ПС, Ложь);
		Параметры.Порция = Макс(ПорцияФайлов, 1);
	Иначе
		Параметры = Обработка.ПараметрыПроводок();
		Параметры.ВидыДокументов = ОтмеченныеВиды();
		Параметры.ИсключитьРегистры = РазобратьСписок(ИсключитьРегистры);
	КонецЕсли;
	Параметры.Позиция = Позиция;

	Если ИмяМетода = "ПроверитьФайлыНаТомах" Тогда
		Возврат Обработка.ПроверитьФайлыНаТомах(Параметры);
	ИначеЕсли ИмяМетода = "ЗагрузитьФайлыВБазу" Тогда
		Возврат Обработка.ЗагрузитьФайлыВБазу(Параметры);
	ИначеЕсли ИмяМетода = "ПроверитьПереносПроводок" Тогда
		Возврат Обработка.ПроверитьПереносПроводок(Параметры);
	ИначеЕсли ИмяМетода = "ПеренестиПроводкиВОперации" Тогда
		Возврат Обработка.ПеренестиПроводкиВОперации(Параметры);
	КонецЕсли;
	ВызватьИсключение "Неизвестный метод: " + ИмяМетода;

КонецФункции

&НаСервере
Процедура ОбновитьСводкуНаСервере()

	Сводка = ОбъектОбработки().СводкаФайловНаТомах();
	ЗаполнитьТома(Сводка, Неопределено);
	ДобавитьВПротокол(Протокол, СтрШаблон("На томах %1 файлов, %2 МБ; новые файлы: %3.", Сводка.Файлов,
		Формат(Сводка.Размер / 1024 / 1024, "ЧДЦ=1; ЧН=0"), Сводка.СпособХранения));
	Для Каждого Справочник Из Сводка.Справочники Цикл
		ДобавитьВПротокол(Протокол, СтрШаблон("  %1: %2", Справочник.Справочник, Справочник.Файлов));
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПроверитьДоступНаСервере()

	Доступ = ОбъектОбработки().ДоступСервераКТомам(СтрРазделить(ПодменаПутей, Символы.ПС, Ложь));
	ДобавитьВПротокол(Протокол, "Каталог временных файлов сервера 1С: " + Доступ.КаталогВременныхФайлов);
	ЗаполнитьТома(ОбъектОбработки().СводкаФайловНаТомах(), Доступ.Тома);

КонецПроцедуры

&НаСервере
Функция СохранитьУчетныеДанныеНаСервере(Сервер, Пользователь, Пароль)

	Возврат ОбъектОбработки().СохранитьУчетныеДанныеСервера(Сервер, Пользователь, Пароль);

КонецФункции

&НаСервере
Функция ОтвязатьТомаНаСервере(ТолькоПроверка, ВключаяТомаСФайлами)

	Возврат ОбъектОбработки().ОтвязатьТома(ТолькоПроверка, ВключаяТомаСФайлами);

КонецФункции

&НаСервере
Процедура ЗаполнитьВидыДокументовНаСервере()

	Отмеченные = ОтмеченныеВиды();
	ВидыДокументов.Очистить();
	Для Каждого Вид Из ОбъектОбработки().ВидыДокументовСДвижениями(РазобратьСписок(ПрефиксыДокументов)) Цикл
		Строка = ВидыДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Вид);
		Строка.Пометка = Вид.Предлагается Или Отмеченные.Найти(Вид.Документ) <> Неопределено;
	КонецЦикла;
	ВидыДокументов.Сортировать("Пометка Убыв, Документов Убыв");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТома(Сводка, Доступ)

	Тома.Очистить();
	Для Каждого ОписаниеТома Из Сводка.Тома Цикл
		Строка = Тома.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, ОписаниеТома);
		Строка.РазмерМБ = ОписаниеТома.Размер / 1024 / 1024;
		Строка.Доступен = "не проверялся";
		Если Доступ <> Неопределено Тогда
			Для Каждого Проверка Из Доступ Цикл
				Если Проверка.Том = ОписаниеТома.Том Тогда
					Строка.Путь = Проверка.Путь;
					Строка.Доступен = ?(Проверка.Доступен, "да", "НЕТ");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОтмеченныеВиды()

	Виды = Новый Массив;
	Для Каждого Строка Из ВидыДокументов Цикл
		Если Строка.Пометка Тогда
			Виды.Добавить(Строка.Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат Виды;

КонецФункции

&НаКлиенте
Функция ПроверитьВыборВидов()

	Для Каждого Строка Из ВидыДокументов Цикл
		Если Строка.Пометка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	ПоказатьПредупреждение(, "Заполните список и отметьте виды документов.");
	Возврат Ложь;

КонецФункции

&НаСервереБезКонтекста
Функция РазобратьСписок(Строка)

	Результат = Новый Массив;
	Для Каждого Элемент Из СтрРазделить(Строка, ",;", Ложь) Цикл
		Если Не ПустаяСтрока(Элемент) Тогда
			Результат.Добавить(СокрЛП(Элемент));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ОбъектОбработки()

	Возврат РеквизитФормыВЗначение("Объект");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьВПротокол(Протокол, Текст)

	Протокол = Протокол + ?(ПустаяСтрока(Протокол), "", Символы.ПС) + Формат(ТекущаяДата(), "ДФ=HH:mm:ss") + " " + Текст;

КонецПроцедуры

#КонецОбласти
